          "name": "Kenya VL Facilities",
          "type": "csv",
          "url": "data/primary_vl_facilities.csv",
          "hideSource": true,
          "activeStyle": "vl-by-type",
          "description": "Health facilities offering VL diagnosis and treatment in Kenya.",
          "featureInfoTemplate": {
            "name": "{{Health_Facilities}}",
            "template": "<table class='Terria-feature-info'><tbody><tr><th>Facility</th><td>{{Health_Facilities}}</td></tr><tr><th>VL type</th><td>{{VL_Facility_Type}}</td></tr><tr><th>County</th><td>{{Counties_in_Kenya}}</td></tr><tr><th>Subcounty</th><td>{{Subcounty}}</td></tr></tbody></table>"
