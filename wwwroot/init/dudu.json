                  {
                    "value": "Diagnosis Only",
                    "color": "#c026d3"
                  },
                  {
                    "value": "Diagnosis and Treatment",
                    "color": "#22c55e"
                  }
                ],
                "nullColor": "#9ca3af",
                "nullLabel": "Unclassified"
              },
              "point": {
                "mapType": "enum",
                "column": "VL_Facility_Type",
